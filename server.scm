(define-module (server)
  #:use-module (ice-9 popen)
  #:use-module (ice-9 rdelim)
  #:use-module (srfi srfi-1)
  #:use-module (srfi srfi-11)
  #:use-module (srfi srfi-13)
  #:use-module (json)
  #:use-module (util)
  #:use-module (config)
  #:export (server-list set-server-list! find-server server-name server-label
            server-base-url server-models-url server-key apply-server!
            parse-endpoint quick-connect! fetch-models test-server
            import-servers! normalize-server server-active? add-server!
            delete-server! set-server-field))

(define (set-server-field server key val)
  (let ((p (assoc key server)))
    (if p
        (begin (set-cdr! p val) server)
        (append server (list (cons key val))))))

(define (server-list cfg)
  (let ((s (config-ref cfg "servers")))
    (cond
      ((vector? s) (vector->list s))
      ((list? s) s)
      (else '()))))

(define (set-server-list! cfg servers)
  (config-set! cfg "servers" (list->vector servers))
  cfg)

(define (server-name server)
  (or (json-get server "name") ""))

(define (server-label server)
  (let ((n (server-name server)))
    (if (string-null? n)
        (string-append (or (json-get server "host") "?")
                       ":" (or (json-get server "port") "?"))
        n)))

(define (ensure-path p)
  (cond
    ((or (not (string? p)) (string-null? p)) "/v1")
    ((string=? p "/") "/v1")
    ((string-prefix? "/" p) p)
    (else (string-append "/" p))))

(define (server-base-url server)
  (let ((b (json-get server "base_url")))
    (if (and (string? b) (not (string-null? b)))
        (strip-trailing-slash b)
        (strip-trailing-slash
         (string-append (or (json-get server "scheme") "http")
                        "://"
                        (or (json-get server "host") "127.0.0.1")
                        ":"
                        (let ((p (json-get server "port")))
                          (cond ((number? p) (number->string p))
                                ((string? p) p)
                                (else "8080")))
                        (ensure-path (json-get server "path")))))))

(define (server-models-url server)
  (let ((b (server-base-url server)))
    (if (string-suffix? "/models" b)
        b
        (string-append b "/models"))))

(define (server-key cfg server)
  (let* ((env (json-get server "api_key_env"))
         (key (json-get server "key")))
    (or (and (string? env)
             (not (string-null? env))
             (getenv env))
        (and (string? key) (not (string-null? key)) key)
        (getenv "OPENAI_API_KEY")
        (config-ref cfg "api_key"))))

(define (auth-header cfg server)
  (let ((key (server-key cfg server)))
    (if (and (string? key) (not (string-null? key)))
        (list "-H" (string-append "Authorization: Bearer " key))
        '())))

(define (http-get cfg server url timeout)
  (let* ((cmd (string-append
               "curl -sS -m " (number->string timeout)
               " -H " (shell-quote "Accept: application/json")
               " -H " (shell-quote "User-Agent: kerf/0.2")
               (if (pair? (auth-header cfg server))
                   (string-append " -H " (shell-quote
                                          (cadr (auth-header cfg server))))
                   "")
               " -w " (shell-quote "\n%{http_code}")
               " " (shell-quote url)
               " 2>/dev/null"))
         (p (open-input-pipe cmd))
         (lines '()))
    (let loop ()
      (let ((line (read-line p)))
        (unless (eof-object? line)
          (set! lines (cons line lines))
          (loop))))
    (let* ((st (close-pipe p))
           (rev (reverse lines))
           (code (and (pair? rev)
                      (string->number (last rev))))
           (body (string-join (if (pair? rev) (drop-right rev 1) '()) "\n")))
      (values (or code 0) body (status:exit-val st)))))

(define (model-name x)
  (cond
    ((string? x) x)
    ((list? x)
     (or (json-get x "id")
         (json-get x "name")
         (json-get x "model")
         ""))
    (else "")))

(define (models-from-body body)
  (catch #t
    (lambda ()
      (let ((o (json-read-string body)))
        (let ((items
               (cond
                 ((vector? o) (vector->list o))
                 ((list? o)
                  (let ((d (json-get o "data"))
                        (m (json-get o "models"))
                        (id (json-get o "id")))
                    (cond
                      ((vector? d) (vector->list d))
                      ((vector? m) (vector->list m))
                      ((string? id) (list o))
                      (else '()))))
                 (else '()))))
          (delete-duplicates
           (filter (lambda (s) (not (string-null? s)))
                   (map model-name items))
           string=?))))
    (lambda _ '())))

(define (describe-http status body)
  (cond
    ((= status 0) "offline")
    ((= status 401) "auth required")
    ((= status 403) "forbidden")
    ((= status 404) "no /models endpoint")
    (else
     (let ((line (car (string-split body #\newline))))
       (string-append "http " (number->string status)
                      (if (string-null? line)
                          ""
                          (string-append " · " (truncate-str line 120))))))))

(define (fetch-models cfg server)
  (let-values (((status body exit)
                (http-get cfg server (server-models-url server) 5)))
    (let ((models (if (= status 200) (models-from-body body) '())))
      (cond
        ((= status 200)
         (values #t
                 (if (null? models)
                     "reachable · no model list"
                     (string-append "ok · " (number->string (length models))
                                    " models"))
                 models))
        (else
         (values #f (describe-http status body) '()))))))

(define test-server fetch-models)

(define (split-endpoint s)
  (let* ((scheme (cond ((string-prefix? "https://" s) "https")
                       ((string-prefix? "http://" s) "http")
                       (else "http")))
         (rest (cond ((string-prefix? "https://" s) (substring s 8))
                     ((string-prefix? "http://" s) (substring s 7))
                     (else s)))
         (slash (string-index rest #\/))
         (authority (if slash (substring rest 0 slash) rest))
         (raw-path (if slash (substring rest slash) ""))
         (path (ensure-path raw-path))
         (colon (string-rindex authority #\:))
         (host (if colon (substring authority 0 colon) authority))
         (port (if colon (substring authority (+ colon 1))
                   (if (string=? scheme "https") "443" "8080"))))
    (values scheme host port path)))

(define (parse-endpoint input cfg)
  (let* ((s (string-trim (or input ""))))
    (when (string-null? s)
      (throw 'kerf-error "empty endpoint"))
    (let-values (((scheme host port path) (split-endpoint s)))
      (when (or (string-null? host) (string-null? port))
        (throw 'kerf-error "bad endpoint; use host:port"))
      (let ((name (string-append host ":" port)))
        `(("name" . ,name)
          ("host" . ,host)
          ("port" . ,port)
          ("scheme" . ,scheme)
          ("path" . ,path)
          ("model" . "")
          ("api_key_env" . ,(or (config-ref cfg "api_key_env") ""))
          ("key" . ""))))))

(define (apply-server! cfg server)
  (config-set! cfg "base_url" (server-base-url server))
  (let ((model (json-get server "model")))
    (when (and (string? model) (not (string-null? model)))
      (config-set! cfg "model" model)))
  (let ((env (json-get server "api_key_env")))
    (when (and (string? env) (not (string-null? env)))
      (config-set! cfg "api_key_env" env)))
  (let ((key (json-get server "key")))
    (when (and (string? key) (not (string-null? key)))
      (config-set! cfg "api_key" key)))
  (config-set! cfg "active_server" (server-label server))
  cfg)

(define (server-active? cfg server)
  (let ((a (config-ref cfg "active_server")))
    (and (string? a)
         (or (string=? a (server-label server))
             (string=? a (server-name server))))))

(define (add-server! cfg server)
  (let* ((name (server-label server))
         (servers (server-list cfg))
         (old (find (lambda (s) (string=? (server-label s) name)) servers)))
    (set-server-list!
     cfg
     (if old
         (map (lambda (s)
                (if (string=? (server-label s) name) server s))
              servers)
         (append servers (list server))))))

(define (delete-server! cfg server)
  (let ((name (server-label server)))
    (set-server-list!
     cfg
     (filter (lambda (s) (not (string=? (server-label s) name)))
             (server-list cfg)))))

(define (find-server cfg name)
  (find (lambda (s)
          (or (string=? (server-label s) name)
              (string=? (server-name s) name)))
        (server-list cfg)))

(define (quick-connect! cfg input)
  (let* ((server (parse-endpoint input cfg))
         (applied (apply-server! cfg server)))
    (let-values (((ok message models) (fetch-models applied server)))
      (unless ok
        (throw 'kerf-error message))
      (let* ((model (if (pair? models)
                        (car models)
                        (config-ref applied "model")))
             (server (if (and (string? model) (not (string-null? model)))
                         (set-server-field server "model" model)
                         server))
             (server (set-server-field server "name"
                                       (if (string-null? (server-name server))
                                           (server-label server)
                                           (server-name server))))
             (cfg (if (and (string? model) (not (string-null? model)))
                      (config-set! applied "model" model)
                      applied))
             (cfg (add-server! cfg server)))
        (save-config cfg)
        (values cfg (string-append "connected " (server-label server)
                                   " · " message))))))

(define (normalize-server raw cfg)
  (let* ((base (or (json-get raw "base_url")
                   (json-get raw "url")))
         (parsed (if (and (string? base) (not (string-null? base)))
                     (parse-endpoint base cfg)
                     #f))
         (host (or (json-get raw "host")
                   (and parsed (json-get parsed "host"))
                   "127.0.0.1"))
         (port (let ((p (or (json-get raw "port")
                            (and parsed (json-get parsed "port"))
                            "8080")))
                 (if (number? p) (number->string p) p)))
         (scheme (or (json-get raw "scheme")
                     (and parsed (json-get parsed "scheme"))
                     "http"))
         (path (ensure-path (or (json-get raw "path")
                                (and parsed (json-get parsed "path"))
                                "/v1")))
         (name (or (json-get raw "name")
                   (string-append host ":" port)))
         (model (or (json-get raw "model") ""))
         (env (or (json-get raw "api_key_env")
                  (config-ref cfg "api_key_env")
                  ""))
         (key (or (json-get raw "key") "")))
    `(("name" . ,name)
      ("host" . ,host)
      ("port" . ,port)
      ("scheme" . ,scheme)
      ("path" . ,path)
      ("model" . ,model)
      ("api_key_env" . ,env)
      ("key" . ,key))))

(define (incoming-servers data)
  (cond
    ((vector? data) (vector->list data))
    ((list? data)
     (let ((s (json-get data "servers")))
       (cond
         ((vector? s) (vector->list s))
         ((list? s) s)
         (else (list data)))))
    (else '())))

(define (import-servers! cfg path)
  (unless (file-exists? path)
    (throw 'kerf-error (string-append "no such file: " path)))
  (let* ((data (json-read-string (read-file* path)))
         (raws (incoming-servers data)))
    (when (null? raws)
      (throw 'kerf-error "no servers found in file"))
    (let loop ((rs raws) (cfg cfg) (names '()))
      (if (null? rs)
          (begin
            (save-config cfg)
            (values cfg (reverse names)))
          (let* ((s (normalize-server (car rs) cfg))
                 (cfg (add-server! cfg s)))
            (loop (cdr rs) cfg (cons (server-label s) names)))))))
