(define-module (kerf main)
  #:use-module (ice-9 format)
  #:use-module (ice-9 rdelim)
  #:use-module (srfi srfi-11)
  #:use-module (srfi srfi-13)
  #:use-module (kerf config)
  #:use-module (kerf util)
  #:use-module (kerf json)
  #:use-module (kerf server)
  #:use-module (kerf agent)
  #:use-module (kerf tui)
  #:export (kerf-main))

(define (usage)
  (display "kerf - a small coding agent\n\n")
  (display "usage: kerf [options]\n")
  (display "       kerf --once \"prompt\" [--yes]\n\n")
  (display "options:\n")
  (display "  --once PROMPT     run one prompt without the tui\n")
  (display "  --yes             approve tool calls automatically\n")
  (display "  --model NAME      override the model\n")
  (display "  --workdir DIR     override the working directory\n")
  (display "  --base-url URL    override the api base url\n")
  (display "  --server NAME     apply a saved server profile\n")
  (display "  --connect ADDR    connect to host:port or a full URL\n")
  (display "  --list-servers    print saved server profiles\n")
  (display "  --tool-mode MODE  auto, native, or text\n")
  (display "  --config          print the config path\n")
  (display "  --version         print the version\n")
  (display "  -h, --help        this text\n\n")
  (display "env:\n")
  (display "  KERF_API_KEY      api key (falls back to OPENAI_API_KEY)\n"))

(define (parse-args args)
  (let loop ((a args) (opts '()))
    (cond
      ((null? a) (reverse opts))
      ((member (car a) '("-h" "--help"))
       (loop (cdr a) (cons (cons 'help #t) opts)))
      ((member (car a) '("-v" "--version"))
       (loop (cdr a) (cons (cons 'version #t) opts)))
      ((member (car a) '("-y" "--yes"))
       (loop (cdr a) (cons (cons 'yes #t) opts)))
      ((string=? (car a) "--config")
       (loop (cdr a) (cons (cons 'config #t) opts)))
      ((string=? (car a) "--list-servers")
       (loop (cdr a) (cons (cons 'list-servers #t) opts)))
      ((and (string=? (car a) "--once") (pair? (cdr a)))
       (loop (cddr a) (cons (cons 'once (cadr a)) opts)))
      ((and (string=? (car a) "--model") (pair? (cdr a)))
       (loop (cddr a) (cons (cons 'model (cadr a)) opts)))
      ((and (string=? (car a) "--workdir") (pair? (cdr a)))
       (loop (cddr a) (cons (cons 'workdir (cadr a)) opts)))
      ((and (string=? (car a) "--base-url") (pair? (cdr a)))
       (loop (cddr a) (cons (cons 'base-url (cadr a)) opts)))
      ((and (string=? (car a) "--server") (pair? (cdr a)))
       (loop (cddr a) (cons (cons 'server (cadr a)) opts)))
      ((and (string=? (car a) "--connect") (pair? (cdr a)))
       (loop (cddr a) (cons (cons 'connect (cadr a)) opts)))
      ((and (string=? (car a) "--tool-mode") (pair? (cdr a)))
       (loop (cddr a) (cons (cons 'tool-mode (cadr a)) opts)))
      ((string-prefix? "-" (car a))
       (loop (cdr a) (cons (cons 'unknown (car a)) opts)))
      (else
       (loop (cdr a) (cons (cons 'once (car a)) opts))))))

(define (opt-ref opts key default)
  (let ((p (assoc key opts)))
    (if p (cdr p) default)))

(define (have-command? cmd)
  (let ((s (system* "sh" "-c"
                    (string-append "command -v " cmd " >/dev/null 2>&1"))))
    (and s (zero? (or (status:exit-val s) 1)))))

(define (tty?)
  (let ((s (system* "test" "-t" "0")))
    (and s (zero? (or (status:exit-val s) 1)))))

(define (error-text key args)
  (cond
    ((eq? key 'kerf-error) (if (pair? args) (car args) "error"))
    ((string? key) key)
    (else
     (with-output-to-string
       (lambda ()
         (display key)
         (for-each (lambda (a) (display " ") (write a)) args))))))

(define (run-once cfg prompt auto)
  (let ((messages (list (system-message cfg)
                        `(("role" . "user") ("content" . ,prompt)))))
    (catch #t
      (lambda ()
        (run-agent
         cfg messages
         (lambda (chunk)
           (display chunk)
           (force-output))
         (lambda (name result)
           (format (current-error-port) "~%[~a] ~a~%"
                   name (truncate-str result 300))
           (force-output (current-error-port)))
         (lambda (desc)
           (if auto
               #t
               (begin
                 (format (current-error-port) "~%allow ~a? [y/N] " desc)
                 (force-output (current-error-port))
                 (let ((line (read-line)))
                   (and line
                        (member (string-trim line) '("y" "Y" "yes" "YES"))
                        #t)))))
         #f)
        (newline)
        0)
      (lambda (key . args)
        (format (current-error-port) "kerf: ~a~%" (error-text key args))
        1))))

(define (print-servers cfg)
  (let ((servers (server-list cfg)))
    (if (null? servers)
        (display "no saved servers\n")
        (for-each
         (lambda (s)
           (display (if (server-active? cfg s) "* " "  "))
           (display (server-label s))
           (display "  ")
           (display (server-base-url s))
           (display "  ")
           (display (or (json-get s "model") ""))
           (newline))
         servers))))

(define (kerf-main args)
  (let ((opts (parse-args (cdr args))))
    (cond
      ((opt-ref opts 'help #f)
       (usage)
       0)
      ((opt-ref opts 'version #f)
       (display "kerf 0.2.0\n")
       0)
      ((opt-ref opts 'config #f)
       (display (config-path))
       (newline)
       0)
      ((opt-ref opts 'unknown #f)
       (format (current-error-port) "kerf: unknown option ~a~%"
               (opt-ref opts 'unknown ""))
       1)
      (else
       (let* ((cfg (load-config))
              (server-name (opt-ref opts 'server #f))
              (connect (opt-ref opts 'connect #f))
              (model (opt-ref opts 'model #f))
              (workdir (opt-ref opts 'workdir #f))
              (base-url (opt-ref opts 'base-url #f))
              (tool-mode (opt-ref opts 'tool-mode #f))
              (once (opt-ref opts 'once #f))
              (auto (opt-ref opts 'yes #f)))
         (unless (have-command? "curl")
           (format (current-error-port) "kerf: curl is required~%")
           (exit 1))
         (when (opt-ref opts 'list-servers #f)
           (print-servers cfg)
           (exit 0))
         (when server-name
           (let ((server (find-server cfg server-name)))
             (unless server
               (format (current-error-port) "kerf: no server named ~a~%" server-name)
               (exit 1))
             (apply-server! cfg server)
             (save-config cfg)))
         (when connect
           (catch #t
             (lambda ()
               (let-values (((newcfg msg) (quick-connect! cfg connect)))
                 (set! cfg newcfg)
                 (format (current-error-port) "~a~%" msg)))
             (lambda (key . args)
               (format (current-error-port) "kerf: ~a~%" (error-text key args))
               (exit 1))))
         (when model
           (config-set! cfg "model" model))
         (when base-url
           (config-set! cfg "base_url" base-url))
         (when workdir
           (config-set! cfg "workdir"
                        (if (string-prefix? "/" workdir)
                            workdir
                            (string-append (getcwd) "/" workdir))))
         (when tool-mode
           (unless (member tool-mode '("auto" "native" "text"))
             (format (current-error-port)
                     "kerf: tool mode must be auto, native, or text~%")
             (exit 1))
           (config-set! cfg "tool_mode" tool-mode))
         (cond
           (once
            (exit (run-once cfg once auto)))
           ((not (tty?))
            (format (current-error-port)
                    "kerf: not a terminal; use --once \"prompt\"~%")
            (exit 1))
           (else
            (run-tui cfg)
            (exit 0))))))))
