(define-module (kerf http)
  #:use-module (ice-9 popen)
  #:use-module (ice-9 rdelim)
  #:use-module (srfi srfi-1)
  #:use-module (srfi srfi-11)
  #:use-module (srfi srfi-13)
  #:use-module (kerf json)
  #:use-module (kerf util)
  #:use-module (kerf config)
  #:export (stream-chat extract-text-toolcalls))

(define (api-url base)
  (let ((b (strip-trailing-slash base)))
    (if (string-suffix? "/chat/completions" b)
        b
        (string-append b "/chat/completions"))))

(define (api-key cfg)
  (let ((env (config-ref cfg "api_key_env")))
    (or (and (string? env) (getenv env))
        (getenv "OPENAI_API_KEY")
        (config-ref cfg "api_key"))))

(define (auth-args cfg)
  (let ((key (api-key cfg))
        (extra (config-ref cfg "extra_headers")))
    (append
     (if (and (string? key) (not (string-null? key)))
         (list "-H" (string-append "Authorization: Bearer " key))
         '())
     (if (list? extra)
         (apply append
                (map (lambda (p)
                       (list "-H" (string-append (car p) ": " (cdr p))))
                     extra))
         '()))))

(define (request-body cfg messages tools)
  (append
   `(("model" . ,(config-ref cfg "model"))
     ("messages" . ,(list->vector messages))
     ("stream" . #t)
     ("temperature" . ,(config-ref cfg "temperature")))
   (if tools
       `(("tools" . ,tools)
         ("tool_choice" . "auto"))
       '())))

(define (error-message raw)
  (catch #t
    (lambda ()
      (let* ((o (json-read-string raw))
             (e (json-get o "error")))
        (if e
            (or (json-get e "message") raw)
            raw)))
    (lambda _ raw)))

(define (error->string key args)
  (cond
    ((eq? key 'kerf-error) (if (pair? args) (car args) "error"))
    ((string? key) key)
    (else
     (with-output-to-string
       (lambda ()
         (display key)
         (for-each (lambda (a)
                     (display " ")
                     (write a))
                   args))))))

(define (tool-error? msg)
  (and (string? msg)
       (or (string-contains msg "tool")
           (string-contains msg "function")
           (string-contains msg "400")
           (string-contains msg "422")
           (string-contains msg "Bad Request"))))

(define (extract-blocks content open close)
  (let loop ((s content) (blocks '()))
    (let ((i (string-contains s open)))
      (if i
          (let* ((start (+ i (string-length open)))
                 (j (string-contains s close start)))
            (if j
                (loop (string-append (substring s 0 i)
                                     (substring s (+ j (string-length close))))
                      (cons (substring s start j) blocks))
                (values (substring s 0 i)
                        (reverse (cons (substring s start) blocks)))))
          (values s (reverse blocks))))))

(define (allowed-fence-lang? lang)
  (member (string-downcase lang)
          '("" "json" "tool" "tool_call" "toolcall")))

(define (extract-fences content)
  (let loop ((lines (string-split content #\newline))
             (in #f)
             (open-line "")
             (lang "")
             (buf '())
             (out '())
             (blocks '()))
    (cond
      ((null? lines)
       (let ((out (if in
                      (append (reverse (cons open-line (reverse buf))) out)
                      out)))
         (values (string-join (reverse out) "\n")
                 (reverse blocks))))
      ((and (not in) (string-prefix? "```" (car lines)))
       (loop (cdr lines) #t (car lines)
             (string-trim (substring (car lines) 3))
             '() out blocks))
      (in
       (if (string-prefix? "```" (car lines))
           (let* ((text (string-join (reverse buf) "\n"))
                  (calls (if (allowed-fence-lang? lang)
                             (parse-call-text text)
                             '())))
             (if (pair? calls)
                 (loop (cdr lines) #f "" "" '() out (append calls blocks))
                 (let ((block (cons open-line
                                    (append (reverse buf) (list (car lines))))))
                   (loop (cdr lines) #f "" "" '()
                         (append (reverse block) out)
                         blocks))))
           (loop (cdr lines) #t open-line lang (cons (car lines) buf) out blocks)))
      (else
       (loop (cdr lines) #f "" "" '() (cons (car lines) out) blocks)))))

(define tool-call-counter 0)

(define (next-call-id)
  (set! tool-call-counter (+ tool-call-counter 1))
  (string-append "call_" (number->string tool-call-counter)))

(define (normalize-args a)
  (cond
    ((string? a) a)
    ((or (list? a) (vector? a)) (json-write-string a))
    (else "{}")))

(define (call-object->call obj)
  (and (list? obj)
       (let* ((fn (json-get obj "function"))
              (name (or (json-get obj "name")
                        (json-get obj "tool")
                        (json-get obj "tool_name")
                        (and (list? fn) (json-get fn "name"))))
              (args (or (json-get obj "arguments")
                        (json-get obj "parameters")
                        (json-get obj "input")
                        (and (list? fn) (json-get fn "arguments")))))
         (and (string? name)
              (not (string-null? name))
              `(("id" . ,(or (json-get obj "id") (next-call-id)))
                ("type" . "function")
                ("function" .
                 (("name" . ,name)
                  ("arguments" . ,(normalize-args args)))))))))

(define (calls-from-json v)
  (cond
    ((vector? v) (append-map calls-from-json (vector->list v)))
    ((list? v)
     (let ((tc (json-get v "tool_calls"))
           (one (json-get v "tool_call")))
       (cond
         ((vector? tc) (append-map calls-from-json (vector->list tc)))
         ((list? one) (calls-from-json one))
         (else
          (let ((c (call-object->call v)))
            (if c (list c) '()))))))
    (else '())))

(define (parse-call-text text)
  (catch #t
    (lambda ()
      (calls-from-json (json-read-string (string-trim text))))
    (lambda _ '())))

(define (extract-text-toolcalls content)
  (let ((text content)
        (blocks '()))
    (for-each
     (lambda (pair)
       (let-values (((t b) (extract-blocks text (car pair) (cadr pair))))
         (set! text t)
         (set! blocks (append blocks b))))
     '(("<tool_call>" "</tool_call>")
       ("<|tool_call|>" "<|/tool_call|>")
       ("<tool>" "</tool>")
       ("<function_call>" "</function_call>")))
    (let-values (((text2 fence-calls) (extract-fences text)))
      (let* ((calls (append (append-map parse-call-text blocks) fence-calls)))
        (if (pair? calls)
            (values (string-trim text2) (list->vector calls))
            (let* ((trimmed (string-trim text2))
                   (bare (if (or (string-prefix? "{" trimmed)
                                 (string-prefix? "[" trimmed))
                             (parse-call-text trimmed)
                             '())))
              (if (pair? bare)
                  (values "" (list->vector bare))
                  (values content #f))))))))

(define (stream-once cfg messages tools on-text)
  (let* ((tmp (string-append "/tmp/kerf-"
                             (number->string (getpid))
                             "-"
                             (number->string (random 1000000))
                             ".json"))
         (body (request-body cfg messages tools))
         (timeout (config-ref cfg "timeout"))
         (url (api-url (config-ref cfg "base_url")))
         (content "")
         (finish #f)
         (raw "")
         (tcs (make-hash-table)))
    (define (tc-entry idx)
      (or (hash-ref tcs idx)
          (let ((e (vector "" "function" "" "")))
            (hash-set! tcs idx e)
            e)))
    (define (absorb-tool-call tc assigned)
      (let* ((idx (or (json-get tc "index") assigned 0))
             (e (tc-entry idx))
             (id (json-get tc "id"))
             (fn (json-get tc "function")))
        (when (string? id)
          (vector-set! e 0 id))
        (when (list? fn)
          (let ((name (json-get fn "name"))
                (args (json-get fn "arguments")))
            (when (string? name)
              (vector-set! e 2 name))
            (when (string? args)
              (vector-set! e 3 (string-append (vector-ref e 3) args)))))))
    (define (absorb chunk)
      (let ((err (json-get chunk "error")))
        (when err
          (throw 'kerf-error
                 (string-append "api: "
                                (or (json-get err "message")
                                    (json-write-string err))))))
      (let ((choices (json-get chunk "choices")))
        (when (and (vector? choices) (> (vector-length choices) 0))
          (let* ((choice (vector-ref choices 0))
                 (msg (json-get choice "message"))
                 (delta (or (json-get choice "delta") msg)))
            (when (list? delta)
              (let ((c (json-get delta "content"))
                    (tc (json-get delta "tool_calls")))
                (when (and (string? c) (not (string-null? c)))
                  (set! content (string-append content c))
                  (on-text c))
                (when (vector? tc)
                  (let loop ((i 0))
                    (when (< i (vector-length tc))
                      (absorb-tool-call (vector-ref tc i)
                                        (if msg i #f))
                      (loop (+ i 1)))))))
            (let ((fr (json-get choice "finish_reason")))
              (when (and (string? fr) (not (string-null? fr)))
                (set! finish fr)))))))
    (define (handle-line line)
      (cond
        ((string-prefix? "data:" line)
         (let ((payload (string-trim (substring line 5))))
           (unless (string=? payload "[DONE]")
             (when (not (string-null? payload))
               (absorb (json-read-string payload))))))
        ((string-prefix? ":" line) #f)
        ((string-null? line) #f)
        (else (set! raw (string-append raw line "\n")))))
    (define (toolcalls)
      (let ((idxs (sort (hash-map->list (lambda (k v) k) tcs) <)))
        (and (pair? idxs)
             (list->vector
              (map (lambda (i)
                     (let* ((e (hash-ref tcs i))
                            (id (if (string-null? (vector-ref e 0))
                                    (string-append "call_" (number->string i))
                                    (vector-ref e 0))))
                       `(("id" . ,id)
                         ("type" . "function")
                         ("function" .
                          (("name" . ,(vector-ref e 2))
                           ("arguments" . ,(vector-ref e 3)))))))
                   idxs)))))
    (define (try-absorb-json raw-body)
      (catch #t
        (lambda ()
          (absorb (json-read-string raw-body))
          #t)
        (lambda (key . args)
          (if (eq? key 'kerf-error)
              (apply throw key args)
              #f))))
    (dynamic-wind
      (lambda ()
        (call-with-output-file tmp
          (lambda (p)
            (set-port-encoding! p "UTF-8")
            (display (json-write-string body) p))))
      (lambda ()
        (let* ((args (append
                      (list "curl" "-sS" "-N"
                            "--max-time" (number->string timeout)
                            "-H" "Content-Type: application/json"
                            "-H" "Accept: text/event-stream"
                            "-X" "POST" url
                            "--data-binary" (string-append "@" tmp))
                      (auth-args cfg)))
               (p (apply open-pipe* OPEN_READ args)))
          (let loop ()
            (let ((line (read-line p)))
              (unless (eof-object? line)
                (handle-line line)
                (loop))))
          (let ((status (close-pipe p)))
            (when (and (not (toolcalls))
                       (string-null? content)
                       (not (string-null? raw)))
              (unless (try-absorb-json raw)
                (throw 'kerf-error
                       (string-append "api: " (error-message raw)))))
            (when (and (not (toolcalls))
                       (string-null? content)
                       (not (zero? (or (status:exit-val status) 1)))
                       (string-null? raw))
              (throw 'kerf-error
                     (string-append "curl failed with status "
                                    (number->string
                                     (or (status:exit-val status) 1)))))
            (values content (toolcalls) finish))))
      (lambda ()
        (when (file-exists? tmp)
          (delete-file tmp))))))

(define (stream-chat cfg messages tools on-text)
  (let* ((mode (or (config-ref cfg "tool_mode") "auto"))
         (use-tools (and tools (not (equal? mode "text"))))
         (emitted #f))
    (define (emit chunk)
      (set! emitted #t)
      (on-text chunk))
    (define (attempt ts)
      (stream-once cfg messages ts emit))
    (let-values (((content toolcalls finish)
                  (catch #t
                    (lambda ()
                      (attempt use-tools))
                    (lambda (key . args)
                      (let ((msg (error->string key args)))
                        (if (and (not (equal? mode "native"))
                                 (not emitted)
                                 (tool-error? msg))
                            (attempt #f)
                            (apply throw key args)))))))
      (let-values (((clean text-calls) (extract-text-toolcalls content)))
        (cond
          ((and toolcalls (> (vector-length toolcalls) 0))
           (values (if (string-null? clean) content clean)
                   toolcalls finish))
          ((and text-calls (> (vector-length text-calls) 0))
           (values clean text-calls finish))
          (else
           (values content #f finish)))))))
