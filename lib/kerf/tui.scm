(define (st-ref st i) (vector-ref st i))
(define (st-set! st i v) (vector-set! st i v))

(define (term-size)
  (catch #t
    (lambda ()
      (let* ((ioctl (pointer->procedure
                     int
                     (dynamic-func "ioctl" (dynamic-link))
                     (list int unsigned-long '*)))
             (buf (make-bytevector 8 0)))
        (if (zero? (ioctl 1 #x5413 (bytevector->pointer buf)))
            (let ((r (bytevector-u16-native-ref buf 0))
                  (c (bytevector-u16-native-ref buf 2)))
              (values (if (zero? r) 24 r) (if (zero? c) 80 c)))
            (values 24 80))))
    (lambda _ (values 24 80))))

(define (save-stty)
  (let* ((p (open-input-pipe "stty -g"))
         (s (read-line p)))
    (close-pipe p)
    s))

(define (enable-raw)
  (let ((saved (catch #t save-stty (lambda _ #f))))
    (system* "stty" "raw" "-echo")
    saved))

(define (restore-stty saved)
  (if saved
      (system* "stty" saved)
      (system* "stty" "sane"))
  (force-output))

(define (now-ms)
  (quotient (* 1000 (get-internal-real-time))
            internal-time-units-per-second))

(define (make-state cfg)
  (vector cfg
          '()
          ""
          0
          '()
          #f
          0
          "ready"
          #f
          (list (system-message cfg))
          (now-ms)
          'start
          0
          0
          #f
          0
          #f
          ""
          0
          #f
          #f
          "not tested"
          ""))

(define (append-entry! st role text)
  (st-set! st IDX-TRANSCRIPT
           (append (st-ref st IDX-TRANSCRIPT) (list (cons role text)))))

(define (replace-last! st role text)
  (let ((tr (st-ref st IDX-TRANSCRIPT)))
    (when (pair? tr)
      (st-set! st IDX-TRANSCRIPT
               (append (drop-right tr 1) (list (cons role text)))))))

(define (last-text st)
  (let ((tr (st-ref st IDX-TRANSCRIPT)))
    (if (null? tr) "" (cdr (car (last-pair tr))))))

(define (theme-colors theme)
  (case (string->symbol (or theme "kerf"))
    ((mono)
     '((accent . "15") (accent2 . "7") (dim . "244") (border . "240")
       (text . "252") (user . "15") (tool . "245") (error . "196")
       (success . "15") (warn . "15") (bar . "236") (code . "235")))
    ((amber)
     '((accent . "214") (accent2 . "222") (dim . "179") (border . "130")
       (text . "223") (user . "214") (tool . "180") (error . "203")
       (success . "220") (warn . "214") (bar . "235") (code . "234")))
    (else
     '((accent . "111") (accent2 . "150") (dim . "245") (border . "240")
       (text . "252") (user . "111") (tool . "179") (error . "203")
       (success . "114") (warn . "214") (bar . "236") (code . "235")))))

(define (color theme role)
  (let* ((role (if (string? role) (string->symbol role) role))
         (p (assoc role (theme-colors theme))))
    (if p (cdr p) "252")))

(define (sgr theme role)
  (string-append "\x1b[38;5;" (color theme role) "m"))

(define (bg-color theme role)
  (string-append "\x1b[48;5;" (color theme role) "m"))

(define (selected-style theme)
  (string-append "\x1b[48;5;" (color theme "accent")
                 "m\x1b[38;5;16m\x1b[1m"))

(define (bar-style theme)
  (string-append "\x1b[48;5;" (color theme "bar")
                 "m\x1b[38;5;" (color theme "text") "m"))

(define (style-code theme style)
  (case style
    ((selected) (selected-style theme))
    ((bar) (bar-style theme))
    ((heading) (string-append (sgr theme "accent") "\x1b[1m"))
    ((code) (string-append (bg-color theme "code") (sgr theme "text")))
    ((accent) (sgr theme "accent"))
    ((dim) (sgr theme "dim"))
    ((border) (sgr theme "border"))
    ((user) (sgr theme "user"))
    ((tool) (sgr theme "tool"))
    ((error) (string-append (sgr theme "error") "\x1b[1m"))
    ((info) (sgr theme "dim"))
    (else (sgr theme "text"))))

(define (fit s width)
  (let ((s (if (string? s) s (value-str s))))
    (cond
      ((<= width 0) "")
      ((> (string-length s) width) (substring s 0 width))
      (else (string-append s (make-string (- width (string-length s)) #\space))))))

(define (fit-left-right left right width)
  (let* ((left (if (string? left) left (value-str left)))
         (right (if (string? right) right (value-str right)))
         (left (if (> (string-length left) width)
                   (substring left 0 (max 0 width))
                   left))
         (room (max 0 (- width (string-length left) 1)))
         (right (if (> (string-length right) room)
                    (substring right 0 room)
                    right))
         (pad (max 1 (- width (string-length left) (string-length right)))))
    (string-append left (make-string pad #\space) right)))

(define (center-text s width)
  (let* ((s (if (string? s) s (value-str s)))
         (n (max 0 (quotient (- width (string-length s)) 2))))
    (string-append (make-string n #\space) s)))

(define (value-str v)
  (cond
    ((string? v) v)
    ((number? v) (number->string v))
    ((eq? v #t) "on")
    ((eq? v #f) "off")
    ((null? v) "")
    (else (format #f "~a" v))))

(define (info-line label value)
  (string-append "  " (fit label 9) "  " (or value "")))

(define (shorten s n)
  (let ((s (if (string? s) s (value-str s))))
    (if (and (> n 1) (> (string-length s) n))
        (string-append "…" (substring s (- (string-length s) (- n 1))))
        s)))

(define (input-view input cursor width)
  (let* ((avail (max 1 width))
         (offset (if (> cursor avail) (- cursor avail) 0))
         (end (min (string-length input) (+ offset avail))))
    (values (substring input offset end) (- cursor offset))))

(define (hard-wrap s width)
  (cond
    ((<= width 0) (list ""))
    ((string-null? s) (list ""))
    ((<= (string-length s) width) (list s))
    (else
     (cons (substring s 0 width)
           (hard-wrap (substring s width) width)))))

(define (wrap-paragraph s width)
  (let loop ((words (string-tokenize s)) (line "") (out '()))
    (cond
      ((null? words)
       (reverse (if (string-null? line) out (cons line out))))
      ((string-null? line)
       (let ((w (car words)))
         (if (> (string-length w) width)
             (loop (cons (substring w width) (cdr words))
                   (substring w 0 width)
                   out)
             (loop (cdr words) w out))))
      ((<= (+ (string-length line) 1 (string-length (car words))) width)
       (loop (cdr words)
             (string-append line " " (car words))
             out))
      (else
       (loop words "" (cons line out))))))

(define (wrap-text s width)
  (if (<= width 0)
      (list "")
      (append-map (lambda (p)
                    (if (string-null? p)
                        (list "")
                        (wrap-paragraph p width)))
                  (string-split s #\newline))))

(define (entry-lines entry width)
  (let* ((role (car entry))
         (text (cdr entry))
         (bodyw (max 1 (- width 2)))
         (prefix (case role
                   ((user) "▌ ")
                   ((kerf) "▌ ")
                   ((tool) "▪ ")
                   ((error) "▌ ")
                   ((info) "· ")
                   (else "  "))))
    (let loop ((ls (string-split text #\newline))
               (in-code #f)
               (out '()))
      (if (null? ls)
          (reverse out)
          (let ((line (car ls)))
            (cond
              ((string-prefix? "```" line)
               (loop (cdr ls) (not in-code) out))
              (in-code
               (let ((wrapped (hard-wrap line bodyw)))
                 (loop (cdr ls) in-code
                       (append (reverse
                                (map (lambda (l)
                                       (list role 'code (string-append "│ " l)))
                                     wrapped))
                               out))))
              ((string-prefix? "#" line)
               (let* ((h (let strip ((s line))
                           (if (and (not (string-null? s))
                                    (char=? (string-ref s 0) #\#))
                               (strip (substring s 1))
                               s)))
                      (h (string-trim h))
                      (wrapped (wrap-text (if (string-null? h) " " h) bodyw)))
                 (loop (cdr ls) #f
                       (append (reverse
                                (map (lambda (l i)
                                       (list role 'heading
                                             (string-append (if (zero? i) "▌ " "  ") l)))
                                     wrapped (iota (length wrapped))))
                               out))))
              ((or (string-prefix? "- " line)
                   (string-prefix? "* " line))
               (let ((b (string-append "• " (substring line 2))))
                 (loop (cdr ls) #f
                       (append (reverse
                                (map (lambda (l)
                                       (list role role (string-append "  " l)))
                                     (wrap-text b bodyw)))
                               out))))
              (else
               (let ((wrapped (if (string-null? line)
                                  (list "")
                                  (wrap-text line bodyw))))
                 (loop (cdr ls) #f
                       (append (reverse
                                (map (lambda (l i)
                                       (list role role
                                             (string-append (if (zero? i) prefix "  ") l)))
                                     wrapped (iota (length wrapped))))
                               out))))))))))

(define (transcript-lines tr width)
  (let ((all (append-map (lambda (e)
                           (append (entry-lines e width)
                                   (list (list 'blank 'text ""))))
                         tr)))
    (if (null? all) all (drop-right all 1))))

(define (welcome-lines width)
  (list (list 'blank 'text "")
        (list 'info 'heading "  kerf")
        (list 'info 'text "  a small coding agent")
        (list 'blank 'text "")
        (list 'info 'text "  type a message. /help lists commands.")
        (list 'blank 'text "")
        (list 'info 'dim "  ^s options   ^o servers   ^n connect   ^c quit")))

(define (print-styled-line theme style text width)
  (if (eq? style 'raw)
      (begin
        (display text)
        (display "\x1b[K"))
      (begin
        (display (style-code theme style))
        (display (fit text width))
        (display "\x1b[0m\x1b[K"))))

(define (header-line theme left right width)
  (string-append (bar-style theme)
                 (fit-left-right (string-append " " left " ")
                                 (string-append right " ")
                                 width)
                 "\x1b[0m"))

(define (footer-line theme text width)
  (string-append (bar-style theme)
                 (fit (string-append " " text) width)
                 "\x1b[0m"))

(define (pad-lines lines n)
  (let* ((lines (take lines (min (length lines) n)))
         (need (max 0 (- n (length lines)))))
    (append lines (make-list need (list 'blank 'text "")))))

(define start-tab-names '("Session" "Servers" "Options" "About"))

(define (settings-fields cfg)
  (let ((active (config-ref cfg "active_server")))
    (list
     (list "server" "Server"
           (if (and (string? active) (not (string-null? active))) active "none")
           'action)
     (list "model" "Model" (or (config-ref cfg "model") "") 'edit)
     (list "base_url" "Base URL" (or (config-ref cfg "base_url") "") 'edit)
     (list "api_key" "API key"
           (let ((k (config-ref cfg "api_key")))
             (if (and (string? k) (not (string-null? k))) "********" ""))
           'edit)
     (list "workdir" "Workdir" (or (config-ref cfg "workdir") "") 'edit)
     (list "tool_mode" "Tool mode" (or (config-ref cfg "tool_mode") "auto") 'cycle)
     (list "auto_approve" "Auto approve"
           (if (config-ref cfg "auto_approve") "on" "off") 'toggle)
     (list "temperature" "Temperature" (config-ref cfg "temperature") 'edit)
     (list "max_steps" "Max steps" (config-ref cfg "max_steps") 'edit)
     (list "timeout" "Timeout" (config-ref cfg "timeout") 'edit)
     (list "theme" "Theme" (or (config-ref cfg "theme") "kerf") 'cycle)
     (list "save" "Save" "write config" 'save)
     (list "reload" "Reload" "read config" 'reload))))

(define (active-server cfg)
  (let ((a (config-ref cfg "active_server")))
    (and (string? a)
         (not (string-null? a))
         (find-server cfg a))))

(define (server-endpoint server)
  (string-append (or (json-get server "host") "?")
                 ":"
                 (let ((p (json-get server "port")))
                   (cond ((number? p) (number->string p))
                         ((string? p) p)
                         (else "?")))))

(define (session-content st cw main-h)
  (let* ((cfg (st-ref st IDX-CFG))
         (active (active-server cfg))
         (server (if active (server-label active)
                     (let ((a (config-ref cfg "active_server")))
                       (if (and (string? a) (not (string-null? a))) a "direct"))))
         (logo '("██╗  ██╗███████╗██████╗ ███████╗"
                 "██║ ██╔╝██╔════╝██╔══██╗██╔════╝"
                 "█████╔╝ █████╗  ██████╔╝█████╗"
                 "██╔═██╗ ██╔══╝  ██╔══██╗██╔══╝"
                 "██║  ██╗███████╗██║  ██║██║"
                 "╚═╝  ╚═╝╚══════╝╚═╝  ╚═╝╚═╝"))
         (base (produce-logo logo cw main-h))
         (rest
          (list
           (list 'info 'dim (center-text "a small coding agent" cw))
           (list 'blank 'text "")
           (list 'info 'text (info-line "server" server))
           (list 'info 'text (info-line "endpoint" (shorten (or (config-ref cfg "base_url") "") (- cw 14))))
           (list 'info 'text (info-line "model" (shorten (value-str (config-ref cfg "model")) (- cw 14))))
           (list 'info 'text (info-line "workdir" (shorten (or (config-ref cfg "workdir") "") (- cw 14))))
           (list 'info 'text (info-line "tool mode" (value-str (config-ref cfg "tool_mode"))))
           (list 'blank 'text "")
           (list 'info 'heading "  quick actions")
           (list 'info 'accent "  [ enter ]    start session")
           (list 'info 'text "  [ ctrl-o ]   servers")
           (list 'info 'text "  [ ctrl-s ]   options")
           (list 'info 'text "  [ ctrl-n ]   connect host:port")
           (list 'info 'text "  [ q ]        quit")
           (list 'blank 'text "")
           (list 'info 'dim "  tip: connect a local qwen server with ctrl-n."))))
    (append base rest)))

(define (produce-logo logo cw main-h)
  (if (and (>= cw 40) (>= main-h 18))
      (append
       (map (lambda (l) (list 'info 'accent (center-text l cw))) logo)
       (list (list 'blank 'text "")))
      (list (list 'info 'heading (center-text "K E R F" cw)))))

(define (servers-content st cw main-h)
  (let* ((cfg (st-ref st IDX-CFG))
         (servers (server-list cfg))
         (sel (if (null? servers) 0 (min (st-ref st IDX-SEL) (- (length servers) 1))))
         (rows (map (lambda (s i)
                      (let* ((active (server-active? cfg s))
                             (mark (if active "● " "○ "))
                             (line (string-append
                                    "  " mark
                                    (fit (server-label s) 16)
                                    "  "
                                    (fit (server-endpoint s) 21)
                                    "  "
                                    (or (json-get s "model") "")))
                             (style (if (= i sel)
                                        'selected
                                        (if active 'accent 'text))))
                        (list 'info style line)))
                    servers
                    (iota (length servers))))
         (selected (and (pair? servers) (list-ref servers sel)))
         (details
          (if selected
              (list
               (list 'blank 'text "")
               (list 'info 'heading "  selected")
               (list 'info 'text (info-line "endpoint" (shorten (server-base-url selected) (- cw 14))))
               (list 'info 'text (info-line "model" (shorten (or (json-get selected "model") "not set") (- cw 14))))
               (list 'info 'text (info-line "key env" (or (json-get selected "api_key_env") "none")))
               (list 'info 'text (info-line "status" (shorten (st-ref st IDX-SERVER-MSG) (- cw 14)))))
              '())))
    (append
     (list
      (list 'info 'heading "  servers")
      (list 'info 'dim "  connect to a local model or a remote endpoint")
      (list 'blank 'text ""))
     (if (null? servers)
         (list
          (list 'info 'heading "  no servers yet.")
          (list 'info 'text "  press c and enter host:port, for example 192.168.1.42:8080")
          (list 'info 'dim "  or press i to import a servers.json file"))
         rows)
     details
     (list
      (list 'blank 'text "")
      (list 'info 'dim "  enter connect   a add   e edit   d delete   t test")
      (list 'info 'dim "  c quick connect   i import   esc back")))))

(define (options-content st cw main-h)
  (let* ((cfg (st-ref st IDX-CFG))
         (fields (settings-fields cfg))
         (sel (min (st-ref st IDX-SEL) (- (length fields) 1)))
         (rows
          (map (lambda (f i)
                 (let* ((label (cadr f))
                        (value (caddr f))
                        (kind (cadddr f))
                        (val (value-str value))
                        (val (if (string-null? val) "—" val))
                        (shown (if (memq kind '(save reload))
                                   (string-append "[ " val " ]")
                                   val))
                        (line (string-append
                               "  " (if (= i sel) "▸ " "  ")
                               (fit label 14) "  " shown))
                        (style (if (= i sel) 'selected 'text)))
                   (list 'info style line)))
               fields
               (iota (length fields)))))
    (append
     (list
      (list 'info 'heading "  options")
      (list 'info 'dim "  enter changes a value · s saves · r reloads")
      (list 'blank 'text ""))
     rows
     (list
      (list 'blank 'text "")
      (list 'info 'dim "  s save   r reload   esc back")
      (list 'info 'dim (string-append "  " (shorten (config-path) (max 10 (- cw 2)))))))))

(define (about-content st cw main-h)
  (let ((cfg (st-ref st IDX-CFG)))
    (list
     (list 'blank 'text "")
     (list 'info 'heading "  kerf 0.2.0")
     (list 'info 'dim "  a small coding agent in guile scheme")
     (list 'blank 'text "")
     (list 'info 'text (info-line "language" (string-append "guile " (version))))
     (list 'info 'text (info-line "config" (shorten (config-path) (- cw 14))))
     (list 'info 'text (info-line "workdir" (shorten (or (config-ref cfg "workdir") "") (- cw 14))))
     (list 'info 'text (info-line "servers" (number->string (length (server-list cfg)))))
     (list 'blank 'text "")
     (list 'info 'heading "  keybinds")
     (list 'info 'text "  ^s options   ^o servers   ^n connect   ^c quit")
     (list 'info 'text "  tab sections   enter select   esc back")
     (list 'blank 'text "")
     (list 'info 'heading "  tools")
     (list 'info 'text "  bash read write edit list grep glob patch webfetch todo")
     (list 'blank 'text "")
     (list 'info 'dim "  no telemetry. no noise. just a sharp little tool."))))

(define (tab-content st cw main-h)
  (case (st-ref st IDX-TAB)
    ((0) (session-content st cw main-h))
    ((1) (servers-content st cw main-h))
    ((2) (options-content st cw main-h))
    (else (about-content st cw main-h))))

(define (sidebar-line st i lw main-h theme)
  (let* ((iw (- lw 2))
         (last (- main-h 1))
         (tab (st-ref st IDX-TAB))
         (border (sgr theme "border"))
         (reset "\x1b[0m"))
    (cond
      ((= i 0)
       (string-append border "╭" (make-string iw #\─) "╮" reset))
      ((= i last)
       (string-append border "╰" (make-string iw #\─) "╯" reset))
      ((and (>= i 1) (<= i 4))
       (let* ((idx (- i 1))
              (selected (= idx tab))
              (label (string-append (if selected " ▸ " "   ")
                                    (list-ref start-tab-names idx)))
              (content (if selected
                           (string-append (selected-style theme)
                                          (fit label iw) reset)
                           (string-append (sgr theme "text")
                                          (fit label iw) reset))))
         (string-append border "│" reset content border "│" reset)))
      ((and (>= i 6) (<= i 9))
       (let* ((hints '("  tab   sections"
                       "  enter select"
                       "  ^s    options"
                       "  q     quit"))
              (content (string-append (sgr theme "dim")
                                      (fit (list-ref hints (- i 6)) iw)
                                      reset)))
         (string-append border "│" reset content border "│" reset)))
      (else
       (string-append border "│" reset
                      (make-string iw #\space)
                      border "│" reset)))))

(define (draw-start st)
  (let-values (((rows cols) (term-size)))
    (let* ((width (max 20 cols))
           (height (max 10 rows))
           (cfg (st-ref st IDX-CFG))
           (theme (or (config-ref cfg "theme") "kerf"))
           (lw (max 12 (min 24 (quotient width 3))))
           (cw (max 8 (- width lw 1)))
           (main-h (max 1 (- height 2)))
           (content (pad-lines (tab-content st cw main-h) main-h))
           (content (take content main-h))
           (active (config-ref cfg "active_server"))
           (right (string-append "start · "
                                 (if (and (string? active) (not (string-null? active)))
                                     active
                                     "direct")))
           (hints (case (st-ref st IDX-TAB)
                    ((0) "tab sections   enter start   ^o servers   ^s options   q quit")
                    ((1) "enter connect   a add   e edit   d delete   t test   c quick   i import   esc back")
                    ((2) "enter change   s save   r reload   esc back")
                    (else "tab sections   esc back   q quit"))))
      (display "\x1b[H")
      (display (header-line theme "▰ kerf 0.2" right width))
      (display "\r\n")
      (let loop ((i 0))
        (when (< i main-h)
          (let ((line (list-ref content i)))
            (display (sidebar-line st i lw main-h theme))
            (display " ")
            (print-styled-line theme (cadr line) (caddr line) cw)
            (when (< i (- main-h 1))
              (display "\r\n"))
            (loop (+ i 1)))))
      (display "\r\n")
      (display (footer-line theme hints width))
      (display "\x1b[?25l")
      (force-output))))

(define (chat-box-top theme width)
  (string-append (sgr theme "border")
                 "╭─ message "
                 (make-string (max 0 (- width 12)) #\─)
                 "╮\x1b[0m"))

(define (chat-box-bottom theme width)
  (string-append (sgr theme "border")
                 "╰"
                 (make-string (max 0 (- width 2)) #\─)
                 "╯\x1b[0m"))

(define (chat-input-line theme input cursor width)
  (let* ((avail (max 1 (- width 6)))
         (vals (call-with-values (lambda () (input-view input cursor avail)) list))
         (view (car vals))
         (vcur (cadr vals))
         (placeholder (string-null? input))
         (shown (if placeholder "type a message..." view))
         (len (string-length shown))
         (pad (max 0 (- width 5 len))))
    (values
     (string-append
      (sgr theme "border") "│\x1b[0m "
      (sgr theme "accent") "❯\x1b[0m "
      (if placeholder (sgr theme "dim") (sgr theme "text"))
      shown "\x1b[0m"
      (make-string pad #\space)
      (sgr theme "border") "│\x1b[0m")
     (+ 5 vcur)
     vcur)))

(define (draw-chat st)
  (let-values (((rows cols) (term-size)))
    (let* ((width (max 20 cols))
           (height (max 10 rows))
           (cfg (st-ref st IDX-CFG))
           (theme (or (config-ref cfg "theme") "kerf"))
           (h (max 1 (- height 5)))
           (tr (st-ref st IDX-TRANSCRIPT))
           (all (if (null? tr) (welcome-lines width) (transcript-lines tr width)))
           (n (length all))
           (scroll (min (st-ref st IDX-SCROLL) (max 0 (- n h))))
           (start (max 0 (- n h scroll)))
           (rest (drop all start))
           (visible (take rest (min h (length rest))))
           (input (st-ref st IDX-INPUT))
           (cursor (st-ref st IDX-CURSOR))
           (active (config-ref cfg "active_server"))
           (server (if (and (string? active) (not (string-null? active)))
                       active "direct"))
           (right (string-append server " · "
                                 (value-str (config-ref cfg "model")) " · "
                                 (shorten (or (config-ref cfg "workdir") "") 28)))
           (status (st-ref st IDX-STATUS))
           (busy (st-ref st IDX-BUSY))
           (streaming (st-ref st IDX-STREAMING))
           (left-status
            (string-append (if busy "● " "· ") status
                           (if streaming " · streaming" ""))))
      (display "\x1b[H")
      (display (header-line theme "▰ kerf 0.2" right width))
      (display "\r\n")
      (for-each (lambda (line)
                  (print-styled-line theme (cadr line) (caddr line) width)
                  (display "\r\n"))
                visible)
      (do ((i (length visible) (+ i 1)))
          ((>= i h))
        (print-styled-line theme 'text "" width)
        (display "\r\n"))
      (display (chat-box-top theme width))
      (display "\r\n")
      (let-values (((line col vcur) (chat-input-line theme input cursor width)))
        (display line)
        (display "\r\n")
        (display (chat-box-bottom theme width))
        (display "\r\n")
        (display (string-append (sgr theme "dim")
                                (fit-left-right left-status
                                                "^S opts  ^O servers  ^N connect  ^C quit"
                                                width)
                                "\x1b[0m\x1b[K"))
        (display "\x1b[?25h")
        (display (string-append "\x1b[" (number->string (- height 2))
                                ";" (number->string (min (max 1 col) width)) "H"))
        (force-output)))))

(define (draw-simple-screen st header-right footer-text lines cursor theme)
  (let-values (((rows cols) (term-size)))
    (let* ((width (max 20 cols))
           (height (max 8 rows))
           (main-h (max 1 (- height 2)))
           (lines (take (pad-lines lines main-h) main-h)))
      (display "\x1b[H")
      (display (header-line theme "▰ kerf 0.2" header-right width))
      (display "\r\n")
      (let loop ((ls lines) (i 0))
        (unless (null? ls)
          (let ((line (car ls)))
            (print-styled-line theme (cadr line) (caddr line) width)
            (when (< i (- main-h 1))
              (display "\r\n"))
            (loop (cdr ls) (+ i 1)))))
      (display "\r\n")
      (display (footer-line theme footer-text width))
      (if cursor
          (begin
            (display "\x1b[?25h")
            (display (string-append "\x1b["
                                    (number->string (min (max 1 (car cursor)) height))
                                    ";"
                                    (number->string (min (max 1 (cdr cursor)) width))
                                    "H")))
          (display "\x1b[?25l"))
      (force-output))))

(define (form-fields)
  '(("name" "Name")
    ("host" "Host")
    ("port" "Port")
    ("scheme" "Scheme")
    ("path" "Path")
    ("model" "Model")
    ("api_key_env" "Key env")
    ("key" "API key")))

(define (form-label key)
  (let ((p (assoc key (form-fields))))
    (if p (cadr p) key)))

(define (form-value form key)
  (let ((v (json-get form key)))
    (if (and (string=? key "key")
             (string? v)
             (not (string-null? v)))
        "********"
        (value-str v))))

(define (draw-form st)
  (let* ((cfg (st-ref st IDX-CFG))
         (theme (or (config-ref cfg "theme") "kerf"))
         (form (st-ref st IDX-FORM))
         (sel (st-ref st IDX-FORM-SEL))
         (orig (st-ref st IDX-FORM-ORIG))
         (fields (form-fields))
         (rows (map (lambda (f i)
                      (let* ((key (car f))
                             (label (cadr f))
                             (line (string-append
                                    "  " (if (= i sel) "▸ " "  ")
                                    (fit label 14) "  "
                                    (form-value form key)))
                             (style (if (= i sel) 'selected 'text)))
                        (list 'info style line)))
                    fields
                    (iota (length fields))))
         (lines
          (append
           (list
            (list 'blank 'text "")
            (list 'info 'heading "  server profile")
            (list 'info 'dim "  stored in the kerf config file")
            (list 'blank 'text ""))
           rows
           (list
            (list 'blank 'text "")
            (list 'info 'dim "  enter edit   s save   esc cancel")
            (list 'info 'dim "  scheme cycles with enter; key is stored in config.json")))))
    (draw-simple-screen
     st
     (string-append "servers · " (if (and (string? orig) (not (string-null? orig)))
                                     "edit"
                                     "new"))
     "server profile   enter edit   s save   esc cancel"
     lines #f theme)))

(define (prompt-meta kind)
  (cond
    ((eq? kind 'quick)
     (values "connect server"
             "host:port or URL"
             "enter connect · esc cancel"
             "192.168.1.42:8080"))
    ((eq? kind 'import)
     (values "import servers"
             "path to servers.json"
             "enter import · esc cancel"
             "/mnt/windows/servers.json"))
    ((and (pair? kind) (eq? (car kind) 'setting))
     (values (string-append "options · " (setting-label (cdr kind)))
             "value"
             "enter apply · esc cancel"
             ""))
    ((and (pair? kind) (eq? (car kind) 'form))
     (values (string-append "server · " (form-label (cdr kind)))
             "value"
             "enter apply · esc cancel"
             ""))
    (else (values "prompt" "value" "enter apply · esc cancel" ""))))

(define (draw-prompt st)
  (let* ((cfg (st-ref st IDX-CFG))
         (theme (or (config-ref cfg "theme") "kerf"))
         (kind (st-ref st IDX-PROMPT-KIND))
         (buf (st-ref st IDX-PROMPT-BUF))
         (cur (st-ref st IDX-PROMPT-CUR)))
    (let-values (((title label hints placeholder) (prompt-meta kind)))
      (let-values (((rows cols) (term-size)))
        (let* ((width (max 20 cols))
             (height (max 10 rows))
             (main-h (max 1 (- height 2)))
             (bw (max 18 (min 68 (- width 6))))
             (left (max 1 (quotient (- width bw) 2)))
             (top (max 0 (quotient (- main-h 7) 2)))
             (title (if (> (string-length title) (max 1 (- bw 5)))
                        (substring title 0 (max 1 (- bw 5)))
                        title))
             (avail (max 1 (- bw 6)))
             (vals (call-with-values (lambda () (input-view buf cur avail)) list))
             (view (car vals))
             (vcur (cadr vals))
             (shown (if (string-null? buf) placeholder view))
             (shown-style (if (string-null? buf) "dim" "text"))
             (len (string-length shown))
             (pad (max 0 (- bw 5 len)))
             (box-top (string-append
                       (sgr theme "border") "╭─\x1b[0m "
                       (sgr theme "accent") title "\x1b[0m"
                       (sgr theme "border") " "
                       (make-string (max 0 (- bw 5 (string-length title))) #\─)
                       "╮\x1b[0m"))
             (box-blank (string-append (sgr theme "border") "│\x1b[0m"
                                       (make-string (- bw 2) #\space)
                                       (sgr theme "border") "│\x1b[0m"))
             (box-label (string-append (sgr theme "border") "│\x1b[0m "
                                       (sgr theme "dim") (fit label (- bw 4)) "\x1b[0m "
                                       (sgr theme "border") "│\x1b[0m"))
             (box-input (string-append (sgr theme "border") "│\x1b[0m "
                                       (sgr theme "accent") "❯\x1b[0m "
                                       (style-code theme (string->symbol shown-style))
                                       shown "\x1b[0m"
                                       (make-string pad #\space)
                                       (sgr theme "border") "│\x1b[0m"))
             (box-hints (string-append (sgr theme "border") "│\x1b[0m "
                                       (sgr theme "dim") (fit hints (- bw 4)) "\x1b[0m "
                                       (sgr theme "border") "│\x1b[0m"))
             (box-bottom (string-append (sgr theme "border") "╰"
                                        (make-string (- bw 2) #\─)
                                        "╯\x1b[0m"))
             (box (list box-top box-blank box-label box-input box-blank box-hints box-bottom))
             (before-spaces (make-string (max 0 (- left 1)) #\space))
             (after-spaces (make-string (max 0 (- width (max 0 (- left 1)) bw)) #\space))
             (box (map (lambda (s)
                         (string-append before-spaces s after-spaces))
                       box))
             (before (make-list top (list 'blank 'text "")))
             (after (make-list (max 0 (- main-h (+ top 7)))
                               (list 'blank 'text "")))
             (lines (append before (map (lambda (s) (list 'raw 'raw s)) box) after))
             (cursor-row (+ 2 top 3))
             (cursor-col (+ left 4 vcur)))
        (draw-simple-screen st title "kerf" lines (cons cursor-row cursor-col) theme))))))

(define (setting-label key)
  (case (string->symbol key)
    ((base_url) "Base URL")
    ((api_key) "API key")
    ((workdir) "Workdir")
    ((tool_mode) "Tool mode")
    ((auto_approve) "Auto approve")
    ((temperature) "Temperature")
    ((max_steps) "Max steps")
    ((timeout) "Timeout")
    ((theme) "Theme")
    ((model) "Model")
    (else key)))

(define (error-text key args)
  (cond
    ((eq? key 'kerf-error) (if (pair? args) (car args) "error"))
    ((string? key) key)
    (else
     (with-output-to-string
       (lambda ()
         (display key)
         (for-each (lambda (a) (display " ") (write a)) args))))))

(define (insert-char! st c)
  (let* ((input (st-ref st IDX-INPUT))
         (cur (st-ref st IDX-CURSOR)))
    (st-set! st IDX-INPUT
             (string-append (substring input 0 cur)
                            (string c)
                            (substring input cur)))
    (st-set! st IDX-CURSOR (+ cur 1))))

(define (backspace! st)
  (let* ((input (st-ref st IDX-INPUT))
         (cur (st-ref st IDX-CURSOR)))
    (when (> cur 0)
      (st-set! st IDX-INPUT
               (string-append (substring input 0 (- cur 1))
                              (substring input cur)))
      (st-set! st IDX-CURSOR (- cur 1)))))

(define (delete-char! st)
  (let* ((input (st-ref st IDX-INPUT))
         (cur (st-ref st IDX-CURSOR)))
    (when (< cur (string-length input))
      (st-set! st IDX-INPUT
               (string-append (substring input 0 cur)
                              (substring input (+ cur 1)))))))

(define (prompt-insert! st c)
  (let* ((input (st-ref st IDX-PROMPT-BUF))
         (cur (st-ref st IDX-PROMPT-CUR)))
    (st-set! st IDX-PROMPT-BUF
             (string-append (substring input 0 cur)
                            (string c)
                            (substring input cur)))
    (st-set! st IDX-PROMPT-CUR (+ cur 1))))

(define (prompt-backspace! st)
  (let* ((input (st-ref st IDX-PROMPT-BUF))
         (cur (st-ref st IDX-PROMPT-CUR)))
    (when (> cur 0)
      (st-set! st IDX-PROMPT-BUF
               (string-append (substring input 0 (- cur 1))
                              (substring input cur)))
      (st-set! st IDX-PROMPT-CUR (- cur 1)))))

(define (prompt-delete! st)
  (let* ((input (st-ref st IDX-PROMPT-BUF))
         (cur (st-ref st IDX-PROMPT-CUR)))
    (when (< cur (string-length input))
      (st-set! st IDX-PROMPT-BUF
               (string-append (substring input 0 cur)
                              (substring input (+ cur 1)))))))

(define (history-up! st)
  (let ((hist (st-ref st IDX-HISTORY))
        (idx (st-ref st IDX-HIST-IDX)))
    (when (pair? hist)
      (let ((next (if idx (min (+ idx 1) (- (length hist) 1)) 0)))
        (st-set! st IDX-HIST-IDX next)
        (st-set! st IDX-INPUT (list-ref hist next))
        (st-set! st IDX-CURSOR (string-length (list-ref hist next)))))))

(define (history-down! st)
  (let ((hist (st-ref st IDX-HISTORY))
        (idx (st-ref st IDX-HIST-IDX)))
    (when idx
      (if (>= idx 1)
          (let ((next (- idx 1)))
            (st-set! st IDX-HIST-IDX next)
            (st-set! st IDX-INPUT (list-ref hist next))
            (st-set! st IDX-CURSOR (string-length (list-ref hist next))))
          (begin
            (st-set! st IDX-HIST-IDX #f)
            (st-set! st IDX-INPUT "")
            (st-set! st IDX-CURSOR 0))))))

(define (push-history! st input)
  (when (not (string-null? input))
    (st-set! st IDX-HISTORY
             (cons input (st-ref st IDX-HISTORY))))
  (st-set! st IDX-HIST-IDX #f))

(define (draw! st)
  (case (st-ref st IDX-MODE)
    ((chat) (draw-chat st))
    ((form) (draw-form st))
    ((prompt) (draw-prompt st))
    (else (draw-start st))))

(define (maybe-draw! st force)
  (let ((t (now-ms)))
    (when (or force (> (- t (st-ref st IDX-LAST)) 40))
      (st-set! st IDX-LAST t)
      (draw! st))))

(define (open-options! st)
  (st-set! st IDX-MODE 'start)
  (st-set! st IDX-TAB 2)
  (st-set! st IDX-SEL 0)
  (st-set! st IDX-STATUS "options")
  (draw! st))

(define (open-servers! st)
  (st-set! st IDX-MODE 'start)
  (st-set! st IDX-TAB 1)
  (st-set! st IDX-SEL 0)
  (st-set! st IDX-STATUS "servers")
  (draw! st))

(define (back-to-base! st)
  (if (st-ref st IDX-CHAT-STARTED)
      (begin
        (st-set! st IDX-MODE 'chat)
        (st-set! st IDX-STATUS "ready")
        (draw! st))
      (begin
        (st-set! st IDX-MODE 'start)
        (st-set! st IDX-TAB 0)
        (st-set! st IDX-SEL 0)
        (st-set! st IDX-STATUS "ready")
        (draw! st))))

(define (start-chat! st)
  (let ((cfg (st-ref st IDX-CFG)))
    (unless (st-ref st IDX-CHAT-STARTED)
      (st-set! st IDX-CHAT-STARTED #t)
      (append-entry!
       st 'info
       (string-append "session · "
                      (value-str (config-ref cfg "active_server"))
                      " · "
                      (value-str (config-ref cfg "model"))))
      (let* ((env (config-ref cfg "api_key_env"))
             (key (or (and (string? env) (getenv env))
                      (getenv "OPENAI_API_KEY")
                      (config-ref cfg "api_key")))
             (base (or (config-ref cfg "base_url") "")))
        (unless (or (and (string? key) (not (string-null? key)))
                    (string-contains base "127.0.0.1")
                    (string-contains base "localhost"))
          (append-entry! st 'info "no api key · set KERF_API_KEY or use a local server"))))
    (st-set! st IDX-MODE 'chat)
    (st-set! st IDX-STATUS "ready")
    (draw! st)))

(define (selected-server st)
  (let* ((cfg (st-ref st IDX-CFG))
         (servers (server-list cfg))
         (sel (st-ref st IDX-SEL)))
    (and (pair? servers)
         (list-ref servers (min sel (- (length servers) 1))))))

(define (connect-selected! st)
  (let* ((cfg (st-ref st IDX-CFG))
         (server (selected-server st)))
    (if (not server)
        (begin
          (st-set! st IDX-STATUS "no server selected")
          (draw! st))
        (begin
          (apply-server! cfg server)
          (save-config cfg)
          (st-set! st IDX-SERVER-MSG (string-append "connected " (server-label server)))
          (st-set! st IDX-STATUS (string-append "connected " (server-label server)))
          (if (st-ref st IDX-CHAT-STARTED)
              (begin
                (st-set! st IDX-MODE 'chat)
                (draw! st))
              (begin
                (st-set! st IDX-TAB 0)
                (st-set! st IDX-SEL 0)
                (draw! st)))))))

(define (test-selected! st)
  (let* ((cfg (st-ref st IDX-CFG))
         (server (selected-server st)))
    (if (not server)
        (begin
          (st-set! st IDX-STATUS "no server selected")
          (draw! st))
        (begin
          (st-set! st IDX-STATUS (string-append "testing " (server-label server) "..."))
          (draw! st)
          (catch #t
            (lambda ()
              (let-values (((ok msg models) (fetch-models cfg server)))
                (st-set! st IDX-SERVER-MSG msg)
                (st-set! st IDX-STATUS
                         (string-append (if ok "ok · " "error · ") msg))
                (draw! st)))
            (lambda (key . args)
              (st-set! st IDX-SERVER-MSG (error-text key args))
              (st-set! st IDX-STATUS (string-append "error · " (error-text key args)))
              (draw! st)))))))

(define (prompt-yes-no st msg)
  (st-set! st IDX-STATUS (string-append msg " [y/N]"))
  (draw! st)
  (let loop ((c (read-char)))
    (cond
      ((eof-object? c) #f)
      ((memv c '(#\y #\Y)) #t)
      ((memv c '(#\n #\N #\return #\newline #\x7f #\x03)) #f)
      (else (loop (read-char))))))

(define (delete-selected! st)
  (let* ((cfg (st-ref st IDX-CFG))
         (server (selected-server st)))
    (when server
      (if (prompt-yes-no st (string-append "delete " (server-label server) "?"))
          (begin
            (when (server-active? cfg server)
              (config-set! cfg "active_server" ""))
            (delete-server! cfg server)
            (save-config cfg)
            (st-set! st IDX-SEL 0)
            (st-set! st IDX-STATUS (string-append "deleted " (server-label server)))
            (draw! st))
          (begin
            (st-set! st IDX-STATUS "cancelled")
            (draw! st))))))

(define (new-server-form cfg)
  `(("name" . "")
    ("host" . "127.0.0.1")
    ("port" . "8080")
    ("scheme" . "http")
    ("path" . "/v1")
    ("model" . "")
    ("api_key_env" . ,(or (config-ref cfg "api_key_env") ""))
    ("key" . "")))

(define (add-server-form! st)
  (st-set! st IDX-FORM (new-server-form (st-ref st IDX-CFG)))
  (st-set! st IDX-FORM-ORIG "")
  (st-set! st IDX-FORM-SEL 0)
  (st-set! st IDX-MODE 'form)
  (st-set! st IDX-STATUS "new server")
  (draw! st))

(define (edit-server-form! st)
  (let ((server (selected-server st)))
    (when server
      (st-set! st IDX-FORM server)
      (st-set! st IDX-FORM-ORIG (server-label server))
      (st-set! st IDX-FORM-SEL 0)
      (st-set! st IDX-MODE 'form)
      (st-set! st IDX-STATUS "edit server")
      (draw! st))))

(define (save-form! st)
  (let* ((cfg (st-ref st IDX-CFG))
         (form (st-ref st IDX-FORM))
         (orig (st-ref st IDX-FORM-ORIG))
         (host (or (json-get form "host") ""))
         (port (value-str (json-get form "port")))
         (name (or (json-get form "name") "")))
    (cond
      ((string-null? host)
       (st-set! st IDX-STATUS "host is required")
       (draw! st))
      ((not (string->number port))
       (st-set! st IDX-STATUS "port must be numeric")
       (draw! st))
      (else
       (let* ((name (if (string-null? name)
                        (string-append host ":" port)
                        name))
              (form (set-server-field form "name" name))
              (form (set-server-field form "path"
                                      (let ((p (json-get form "path")))
                                        (if (and (string? p) (not (string-null? p)))
                                            p
                                            "/v1")))))
         (when (and (string? orig)
                    (not (string-null? orig))
                    (not (string=? orig name)))
           (let ((old (find-server cfg orig)))
             (when old (delete-server! cfg old))))
         (add-server! cfg form)
         (save-config cfg)
         (let* ((servers (server-list cfg))
                (idx (list-index (lambda (s) (string=? (server-label s) name)) servers)))
           (st-set! st IDX-SEL (or idx 0)))
         (st-set! st IDX-MODE 'start)
         (st-set! st IDX-TAB 1)
         (st-set! st IDX-STATUS (string-append "saved " name))
         (draw! st))))))

(define (reload-config! st)
  (let ((newcfg (load-config)))
    (st-set! st IDX-CFG newcfg)
    (let ((msgs (st-ref st IDX-MESSAGES)))
      (when (pair? msgs)
        (st-set! st IDX-MESSAGES (cons (system-message newcfg) (cdr msgs)))))
    (st-set! st IDX-STATUS "reloaded")
    (draw! st)))

(define (cycle-setting! st key)
  (let* ((cfg (st-ref st IDX-CFG)))
    (cond
      ((string=? key "tool_mode")
       (let* ((cur (or (config-ref cfg "tool_mode") "auto"))
              (next (cond ((string=? cur "auto") "native")
                          ((string=? cur "native") "text")
                          (else "auto"))))
         (config-set! cfg "tool_mode" next)))
      ((string=? key "theme")
       (let* ((cur (or (config-ref cfg "theme") "kerf"))
              (next (cond ((string=? cur "kerf") "mono")
                          ((string=? cur "mono") "amber")
                          (else "kerf"))))
         (config-set! cfg "theme" next)))
      ((string=? key "auto_approve")
       (config-set! cfg "auto_approve" (not (config-ref cfg "auto_approve")))))
    (save-config cfg)
    (st-set! st IDX-STATUS "saved")
    (draw! st)))

(define (expand-workdir cfg p)
  (cond
    ((string-prefix? "~/" p)
     (string-append (home-dir) (substring p 1)))
    ((string-prefix? "/" p) p)
    (else
     (string-append (strip-trailing-slash (config-ref cfg "workdir")) "/" p))))

(define (commit-setting! st key value)
  (let* ((cfg (st-ref st IDX-CFG))
         (active (active-server cfg)))
    (cond
      ((string=? key "model")
       (config-set! cfg "model" value)
       (when active
         (add-server! cfg (set-server-field active "model" value)))
       (save-config cfg)
       (st-set! st IDX-STATUS "saved model")
       #t)
      ((string=? key "base_url")
       (config-set! cfg "base_url" (strip-trailing-slash value))
       (config-set! cfg "active_server" "")
       (save-config cfg)
       (st-set! st IDX-STATUS "saved endpoint")
       #t)
      ((string=? key "api_key")
       (config-set! cfg "api_key" (string-trim value))
       (save-config cfg)
       (st-set! st IDX-STATUS "saved api key")
       #t)
      ((string=? key "workdir")
       (let ((full (expand-workdir cfg value)))
         (if (and (file-exists? full)
                  (eq? (stat:type (stat full)) 'directory))
             (begin
               (config-set! cfg "workdir" full)
               (save-config cfg)
               (st-set! st IDX-STATUS "saved workdir")
               #t)
             (begin
               (st-set! st IDX-STATUS (string-append "no such directory: " full))
               #f))))
      ((string=? key "temperature")
       (let ((n (string->number value)))
         (if (and n (>= n 0) (<= n 2))
             (begin
               (config-set! cfg "temperature" n)
               (save-config cfg)
               (st-set! st IDX-STATUS "saved temperature")
               #t)
             (begin
               (st-set! st IDX-STATUS "temperature must be a number from 0 to 2")
               #f))))
      ((string=? key "max_steps")
       (let ((n (string->number value)))
         (if (and n (integer? n) (> n 0))
             (begin
               (config-set! cfg "max_steps" n)
               (save-config cfg)
               (st-set! st IDX-STATUS "saved max steps")
               #t)
             (begin
               (st-set! st IDX-STATUS "max steps must be a positive integer")
               #f))))
      ((string=? key "timeout")
       (let ((n (string->number value)))
         (if (and n (integer? n) (> n 0))
             (begin
               (config-set! cfg "timeout" n)
               (save-config cfg)
               (st-set! st IDX-STATUS "saved timeout")
               #t)
             (begin
               (st-set! st IDX-STATUS "timeout must be a positive integer")
               #f))))
      (else
       (st-set! st IDX-STATUS (string-append "unknown setting " key))
       #f))))

(define (settings-action! st)
  (let* ((cfg (st-ref st IDX-CFG))
         (fields (settings-fields cfg))
         (sel (min (st-ref st IDX-SEL) (- (length fields) 1)))
         (field (list-ref fields sel))
         (key (car field))
         (kind (cadddr field)))
    (case kind
      ((action)
       (st-set! st IDX-TAB 1)
       (st-set! st IDX-SEL 0)
       (st-set! st IDX-STATUS "servers")
       (draw! st))
      ((edit)
       (open-prompt! st (cons 'setting key)))
      ((cycle)
       (cycle-setting! st key))
      ((toggle)
       (cycle-setting! st key))
      ((save)
       (save-config cfg)
       (st-set! st IDX-STATUS "saved")
       (draw! st))
      ((reload)
       (reload-config! st))
      (else #f))))

(define (prompt-default st kind)
  (let ((cfg (st-ref st IDX-CFG)))
    (cond
      ((eq? kind 'quick) "")
      ((eq? kind 'import) "")
      ((and (pair? kind) (eq? (car kind) 'setting))
       (value-str (config-ref cfg (cdr kind))))
      ((and (pair? kind) (eq? (car kind) 'form))
       (value-str (json-get (st-ref st IDX-FORM) (cdr kind))))
      (else ""))))

(define (open-prompt! st kind)
  (let-values (((title label hints placeholder) (prompt-meta kind)))
    (let ((value (prompt-default st kind)))
      (st-set! st IDX-PROMPT-KIND kind)
      (st-set! st IDX-PROMPT-BUF value)
      (st-set! st IDX-PROMPT-CUR (string-length value))
      (st-set! st IDX-MODE 'prompt)
      (st-set! st IDX-STATUS title)
      (draw! st))))

(define (prompt-cancel! st)
  (let ((kind (st-ref st IDX-PROMPT-KIND)))
    (cond
      ((or (eq? kind 'quick) (eq? kind 'import))
       (st-set! st IDX-MODE 'start)
       (st-set! st IDX-TAB 1)
       (st-set! st IDX-STATUS "cancelled")
       (draw! st))
      ((and (pair? kind) (eq? (car kind) 'setting))
       (st-set! st IDX-MODE 'start)
       (st-set! st IDX-TAB 2)
       (st-set! st IDX-STATUS "cancelled")
       (draw! st))
      ((and (pair? kind) (eq? (car kind) 'form))
       (st-set! st IDX-MODE 'form)
       (st-set! st IDX-STATUS "cancelled")
       (draw! st))
      (else
       (st-set! st IDX-MODE 'start)
       (draw! st)))))

(define (prompt-commit! st)
  (let* ((kind (st-ref st IDX-PROMPT-KIND))
         (value (st-ref st IDX-PROMPT-BUF)))
    (cond
      ((eq? kind 'quick)
       (st-set! st IDX-STATUS "connecting...")
       (draw! st)
       (catch #t
         (lambda ()
           (let-values (((cfg msg) (quick-connect! (st-ref st IDX-CFG) value)))
             (st-set! st IDX-CFG cfg)
             (st-set! st IDX-SERVER-MSG msg)
             (st-set! st IDX-STATUS msg)
             (st-set! st IDX-MODE 'start)
             (st-set! st IDX-TAB 0)
             (st-set! st IDX-SEL 0)
             (draw! st)))
         (lambda (key . args)
           (st-set! st IDX-STATUS (string-append "error · " (error-text key args)))
           (draw! st))))
      ((eq? kind 'import)
       (st-set! st IDX-STATUS "importing...")
       (draw! st)
       (catch #t
         (lambda ()
           (let-values (((cfg names) (import-servers! (st-ref st IDX-CFG) value)))
             (st-set! st IDX-CFG cfg)
             (st-set! st IDX-STATUS
                      (string-append "imported " (number->string (length names)) " servers"))
             (st-set! st IDX-MODE 'start)
             (st-set! st IDX-TAB 1)
             (st-set! st IDX-SEL 0)
             (draw! st)))
         (lambda (key . args)
           (st-set! st IDX-STATUS (string-append "error · " (error-text key args)))
           (draw! st))))
      ((and (pair? kind) (eq? (car kind) 'setting))
       (if (commit-setting! st (cdr kind) value)
           (begin
             (st-set! st IDX-MODE 'start)
             (st-set! st IDX-TAB 2)
             (draw! st))
           (draw! st)))
      ((and (pair? kind) (eq? (car kind) 'form))
       (let ((form (st-ref st IDX-FORM)))
         (st-set! st IDX-FORM (set-server-field form (cdr kind) value))
         (st-set! st IDX-MODE 'form)
         (st-set! st IDX-STATUS "edited")
         (draw! st)))
      (else (draw! st)))))

(define (help-entry! st)
  (append-entry!
   st 'info
   (string-append
    "/clear  reset conversation and task list\n"
    "/model NAME  switch model\n"
    "/cd PATH  change working directory\n"
    "/connect HOST:PORT  connect a server\n"
    "/server  open server manager\n"
    "/options  open options\n"
    "/tools  list tools\n"
    "/config  show config path\n"
    "/quit  leave\n"
    "^S options  ^O servers  ^N connect  ^C quit\n"
    "page up/down scroll  up/down history")))

(define (confirm-in-tui st desc)
  (if (config-ref (st-ref st IDX-CFG) "auto_approve")
      #t
      (begin
        (st-set! st IDX-STATUS (string-append "allow " desc "? [y/N]"))
        (draw! st)
        (let loop ((c (read-char)))
          (cond
            ((eof-object? c) #f)
            ((memv c '(#\y #\Y))
             (st-set! st IDX-STATUS "working...")
             (draw! st)
             #t)
            ((memv c '(#\n #\N #\return #\newline #\x7f #\x03))
             (st-set! st IDX-STATUS "denied")
             (draw! st)
             #f)
            (else (loop (read-char))))))))

(define (submit! st)
  (let* ((cfg (st-ref st IDX-CFG))
         (input (st-ref st IDX-INPUT)))
    (cond
      ((string-null? input) #t)
      ((st-ref st IDX-BUSY)
       (st-set! st IDX-STATUS "still working")
       #t)
      ((string=? input "/quit") 'quit)
      ((string=? input "/clear")
       (st-set! st IDX-TRANSCRIPT '())
       (st-set! st IDX-MESSAGES (list (system-message cfg)))
       (reset-tools!)
       (st-set! st IDX-INPUT "")
       (st-set! st IDX-CURSOR 0)
       (st-set! st IDX-STATUS "ready")
       #t)
      ((string=? input "/help")
       (help-entry! st)
       (st-set! st IDX-INPUT "")
       (st-set! st IDX-CURSOR 0)
       #t)
      ((string=? input "/tools")
       (append-entry! st 'info
                      "bash read write edit list grep glob patch webfetch todowrite todoread")
       (st-set! st IDX-INPUT "")
       (st-set! st IDX-CURSOR 0)
       #t)
      ((string=? input "/config")
       (append-entry! st 'info (config-path))
       (st-set! st IDX-INPUT "")
       (st-set! st IDX-CURSOR 0)
       #t)
      ((string=? input "/server")
       (st-set! st IDX-INPUT "")
       (st-set! st IDX-CURSOR 0)
       (open-servers! st)
       #t)
      ((string=? input "/options")
       (st-set! st IDX-INPUT "")
       (st-set! st IDX-CURSOR 0)
       (open-options! st)
       #t)
      ((string-prefix? "/connect " input)
       (let ((endpoint (string-trim (substring input 9))))
         (st-set! st IDX-INPUT "")
         (st-set! st IDX-CURSOR 0)
         (st-set! st IDX-STATUS "connecting...")
         (draw! st)
         (catch #t
           (lambda ()
             (let-values (((newcfg msg) (quick-connect! cfg endpoint)))
               (st-set! st IDX-CFG newcfg)
               (st-set! st IDX-SERVER-MSG msg)
               (append-entry! st 'info msg)
               (st-set! st IDX-STATUS "ready")
               (draw! st)))
           (lambda (key . args)
             (let ((msg (error-text key args)))
               (append-entry! st 'error msg)
               (st-set! st IDX-STATUS "error")
               (draw! st)))))
       #t)
      ((string-prefix? "/model " input)
       (let ((m (string-trim (substring input 7))))
         (unless (string-null? m)
           (config-set! cfg "model" m)
           (let ((s (active-server cfg)))
             (when s
               (add-server! cfg (set-server-field s "model" m))))
           (save-config cfg)
           (append-entry! st 'info (string-append "model: " m))))
       (st-set! st IDX-INPUT "")
       (st-set! st IDX-CURSOR 0)
       #t)
      ((string-prefix? "/cd " input)
       (let* ((p (string-trim (substring input 4)))
              (full (expand-workdir cfg p)))
         (if (and (file-exists? full)
                  (eq? (stat:type (stat full)) 'directory))
             (begin
               (config-set! cfg "workdir" full)
               (save-config cfg)
               (append-entry! st 'info (string-append "workdir: " full)))
             (append-entry! st 'error (string-append "no such directory: " p))))
       (st-set! st IDX-INPUT "")
       (st-set! st IDX-CURSOR 0)
       #t)
      ((string-prefix? "/" input)
       (append-entry! st 'error (string-append "unknown command: " input))
       (st-set! st IDX-INPUT "")
       (st-set! st IDX-CURSOR 0)
       #t)
      (else
       (push-history! st input)
       (st-set! st IDX-INPUT "")
       (st-set! st IDX-CURSOR 0)
       (append-entry! st 'user input)
       (st-set! st IDX-MESSAGES
                (append (st-ref st IDX-MESSAGES)
                        (list `(("role" . "user") ("content" . ,input)))))
       (st-set! st IDX-BUSY #t)
       (st-set! st IDX-STREAMING #f)
       (st-set! st IDX-STATUS "thinking...")
       (st-set! st IDX-SCROLL 0)
       (maybe-draw! st #t)
       (catch #t
         (lambda ()
           (let ((new-messages
                  (run-agent
                   cfg
                   (st-ref st IDX-MESSAGES)
                   (lambda (chunk)
                     (unless (st-ref st IDX-STREAMING)
                       (append-entry! st 'kerf "")
                       (st-set! st IDX-STREAMING #t))
                     (replace-last! st 'kerf (string-append (last-text st) chunk))
                     (st-set! st IDX-SCROLL 0)
                     (maybe-draw! st #f))
                   (lambda (name result)
                     (st-set! st IDX-STREAMING #f)
                     (if (string=? name "limit")
                         (append-entry! st 'error result)
                         (append-entry! st 'tool
                                        (string-append name ": "
                                                       (truncate-str result 700))))
                     (st-set! st IDX-STATUS "working...")
                     (st-set! st IDX-SCROLL 0)
                     (maybe-draw! st #t))
                   (lambda (desc) (confirm-in-tui st desc))
                   (lambda (content)
                     (cond
                       ((string-null? content)
                        (when (st-ref st IDX-STREAMING)
                          (let ((tr (st-ref st IDX-TRANSCRIPT)))
                            (when (pair? tr)
                              (st-set! st IDX-TRANSCRIPT (drop-right tr 1))))
                          (st-set! st IDX-STREAMING #f)
                          (maybe-draw! st #t)))
                       (else
                        (if (st-ref st IDX-STREAMING)
                            (replace-last! st 'kerf content)
                            (append-entry! st 'kerf content))
                        (st-set! st IDX-STREAMING #f)
                        (st-set! st IDX-SCROLL 0)
                        (maybe-draw! st #t)))))))
             (st-set! st IDX-MESSAGES new-messages)
             (st-set! st IDX-STATUS "ready")))
         (lambda (key . args)
           (append-entry! st 'error (error-text key args))
           (st-set! st IDX-STREAMING #f)
           (st-set! st IDX-STATUS "error")))
       (st-set! st IDX-BUSY #f)
       (st-set! st IDX-STREAMING #f)
       (maybe-draw! st #t)
       #t))))

(define (key-str? k s)
  (and (string? k) (string=? k s)))

(define (handle-chat-key! st k)
  (cond
    ((eq? k 'eof) 'quit)
    ((and (char? k) (or (char=? k #\return) (char=? k #\newline)))
     (submit! st))
    ((and (char? k) (or (char=? k #\x7f) (char=? k #\x08)))
     (backspace! st)
     (maybe-draw! st #t))
    ((and (char? k) (char=? k #\x15))
     (st-set! st IDX-INPUT "")
     (st-set! st IDX-CURSOR 0)
     (maybe-draw! st #t))
    ((and (char? k) (char=? k #\x0c))
     (draw! st))
    ((and (char? k) (char=? k #\tab))
     (insert-char! st #\space)
     (insert-char! st #\space)
     (maybe-draw! st #t))
    ((and (char? k) (>= (char->integer k) 32))
     (insert-char! st k)
     (maybe-draw! st #t))
    ((key-str? k "[A") (history-up! st) (maybe-draw! st #t))
    ((key-str? k "[B") (history-down! st) (maybe-draw! st #t))
    ((key-str? k "[C")
     (let ((cur (st-ref st IDX-CURSOR))
           (len (string-length (st-ref st IDX-INPUT))))
       (when (< cur len)
         (st-set! st IDX-CURSOR (+ cur 1)))
       (maybe-draw! st #t)))
    ((key-str? k "[D")
     (let ((cur (st-ref st IDX-CURSOR)))
       (when (> cur 0)
         (st-set! st IDX-CURSOR (- cur 1)))
       (maybe-draw! st #t)))
    ((or (key-str? k "[H") (key-str? k "[1~"))
     (st-set! st IDX-CURSOR 0)
     (maybe-draw! st #t))
    ((or (key-str? k "[F") (key-str? k "[4~"))
     (st-set! st IDX-CURSOR (string-length (st-ref st IDX-INPUT)))
     (maybe-draw! st #t))
    ((key-str? k "[3~") (delete-char! st) (maybe-draw! st #t))
    ((key-str? k "[5~")
     (st-set! st IDX-SCROLL (+ (st-ref st IDX-SCROLL) 10))
     (maybe-draw! st #t))
    ((key-str? k "[6~")
     (st-set! st IDX-SCROLL (max 0 (- (st-ref st IDX-SCROLL) 10)))
     (maybe-draw! st #t))
    (else #t)))

(define (switch-tab! st delta)
  (let ((tab (modulo (+ (st-ref st IDX-TAB) delta) 4)))
    (st-set! st IDX-TAB tab)
    (st-set! st IDX-SEL 0)
    (st-set! st IDX-STATUS (list-ref start-tab-names tab))
    (draw! st)))

(define (move-sel! st delta)
  (let* ((tab (st-ref st IDX-TAB))
         (cfg (st-ref st IDX-CFG))
         (count (case tab
                  ((1) (length (server-list cfg)))
                  ((2) (length (settings-fields cfg)))
                  (else 0))))
    (when (> count 0)
      (let ((sel (max 0 (min (+ (st-ref st IDX-SEL) delta) (- count 1)))))
        (st-set! st IDX-SEL sel)
        (draw! st)))))

(define (start-action! st)
  (case (st-ref st IDX-TAB)
    ((0) (start-chat! st))
    ((1) (connect-selected! st))
    ((2) (settings-action! st))
    (else #t)))

(define (handle-start-key! st k)
  (cond
    ((and (char? k) (char=? k #\tab)) (switch-tab! st 1))
    ((and (char? k) (char=? k #\q)) 'quit)
    ((key-str? k "[Z") (switch-tab! st -1))
    ((key-str? k "[C") (switch-tab! st 1))
    ((key-str? k "[D") (switch-tab! st -1))
    ((key-str? k "[A") (move-sel! st -1))
    ((key-str? k "[B") (move-sel! st 1))
    ((and (char? k) (or (char=? k #\return) (char=? k #\newline)))
     (start-action! st))
    ((eq? k 'esc) (back-to-base! st))
    ((and (char? k) (char=? k #\c) (= (st-ref st IDX-TAB) 1))
     (open-prompt! st 'quick))
    ((and (char? k) (char=? k #\i) (= (st-ref st IDX-TAB) 1))
     (open-prompt! st 'import))
    ((and (char? k) (char=? k #\a) (= (st-ref st IDX-TAB) 1))
     (add-server-form! st))
    ((and (char? k) (char=? k #\e) (= (st-ref st IDX-TAB) 1))
     (edit-server-form! st))
    ((and (char? k) (char=? k #\d) (= (st-ref st IDX-TAB) 1))
     (delete-selected! st))
    ((and (char? k) (char=? k #\t) (= (st-ref st IDX-TAB) 1))
     (test-selected! st))
    ((and (char? k) (char=? k #\r) (= (st-ref st IDX-TAB) 1))
     (st-set! st IDX-STATUS "refreshed")
     (draw! st))
    ((and (char? k) (char=? k #\s) (= (st-ref st IDX-TAB) 2))
     (save-config (st-ref st IDX-CFG))
     (st-set! st IDX-STATUS "saved")
     (draw! st))
    ((and (char? k) (char=? k #\r) (= (st-ref st IDX-TAB) 2))
     (reload-config! st))
    (else #t)))

(define (move-form-sel! st delta)
  (let* ((count (length (form-fields)))
         (sel (max 0 (min (+ (st-ref st IDX-FORM-SEL) delta) (- count 1)))))
    (st-set! st IDX-FORM-SEL sel)
    (draw! st)))

(define (cycle-scheme! st)
  (let* ((form (st-ref st IDX-FORM))
         (scheme (or (json-get form "scheme") "http"))
         (next (if (string=? scheme "https") "http" "https")))
    (st-set! st IDX-FORM (set-server-field form "scheme" next))
    (st-set! st IDX-STATUS (string-append "scheme: " next))
    (draw! st)))

(define (handle-form-key! st k)
  (cond
    ((key-str? k "[A") (move-form-sel! st -1))
    ((key-str? k "[B") (move-form-sel! st 1))
    ((and (char? k) (or (char=? k #\return) (char=? k #\newline)))
     (let* ((sel (st-ref st IDX-FORM-SEL))
            (field (list-ref (form-fields) sel))
            (key (car field)))
       (if (string=? key "scheme")
           (cycle-scheme! st)
           (open-prompt! st (cons 'form key)))))
    ((and (char? k) (char=? k #\s))
     (save-form! st))
    ((eq? k 'esc)
     (st-set! st IDX-MODE 'start)
     (st-set! st IDX-TAB 1)
     (st-set! st IDX-STATUS "cancelled")
     (draw! st))
    (else #t)))

(define (handle-prompt-key! st k)
  (cond
    ((and (char? k) (or (char=? k #\return) (char=? k #\newline)))
     (prompt-commit! st))
    ((and (char? k) (or (char=? k #\x7f) (char=? k #\x08)))
     (prompt-backspace! st)
     (maybe-draw! st #t))
    ((and (char? k) (char=? k #\x15))
     (st-set! st IDX-PROMPT-BUF "")
     (st-set! st IDX-PROMPT-CUR 0)
     (maybe-draw! st #t))
    ((and (char? k) (>= (char->integer k) 32))
     (prompt-insert! st k)
     (maybe-draw! st #t))
    ((eq? k 'esc) (prompt-cancel! st))
    ((key-str? k "[A") #t)
    ((key-str? k "[B") #t)
    ((key-str? k "[C")
     (let ((cur (st-ref st IDX-PROMPT-CUR))
           (len (string-length (st-ref st IDX-PROMPT-BUF))))
       (when (< cur len)
         (st-set! st IDX-PROMPT-CUR (+ cur 1)))
       (maybe-draw! st #t)))
    ((key-str? k "[D")
     (let ((cur (st-ref st IDX-PROMPT-CUR)))
       (when (> cur 0)
         (st-set! st IDX-PROMPT-CUR (- cur 1)))
       (maybe-draw! st #t)))
    ((or (key-str? k "[H") (key-str? k "[1~"))
     (st-set! st IDX-PROMPT-CUR 0)
     (maybe-draw! st #t))
    ((or (key-str? k "[F") (key-str? k "[4~"))
     (st-set! st IDX-PROMPT-CUR (string-length (st-ref st IDX-PROMPT-BUF)))
     (maybe-draw! st #t))
    ((key-str? k "[3~") (prompt-delete! st) (maybe-draw! st #t))
    (else #t)))

(define (handle-key! st k)
  (cond
    ((eq? k 'eof) 'quit)
    ((and (char? k) (char=? k #\x03))
     (case (st-ref st IDX-MODE)
       ((prompt) (prompt-cancel! st) #t)
       ((form) (st-set! st IDX-MODE 'start)
               (st-set! st IDX-TAB 1)
               (st-set! st IDX-STATUS "cancelled")
               (draw! st)
               #t)
       (else 'quit)))
    ((and (char? k) (char=? k #\x04))
     (if (eq? (st-ref st IDX-MODE) 'chat) #t 'quit))
    ((and (char? k) (char=? k #\x13))
     (if (memq (st-ref st IDX-MODE) '(start chat))
         (open-options! st)
         #t))
    ((and (char? k) (char=? k #\x0f))
     (if (memq (st-ref st IDX-MODE) '(start chat))
         (open-servers! st)
         #t))
    ((and (char? k) (char=? k #\x0e))
     (if (memq (st-ref st IDX-MODE) '(start chat))
         (open-prompt! st 'quick)
         #t))
    (else
     (case (st-ref st IDX-MODE)
       ((chat) (handle-chat-key! st k))
       ((start) (handle-start-key! st k))
       ((form) (handle-form-key! st k))
       ((prompt) (handle-prompt-key! st k))
       (else #t)))))

(define (read-key)
  (let ((c (read-char)))
    (cond
      ((eof-object? c) 'eof)
      ((char=? c #\escape)
       (let ((a (read-char)))
         (if (and (char? a) (char=? a #\[))
             (let loop ((seq (list #\[)))
               (let ((d (read-char)))
                 (if (char? d)
                     (if (or (char-alphabetic? d) (char=? d #\~))
                         (list->string (reverse (cons d seq)))
                         (loop (cons d seq)))
                     'esc)))
             'esc)))
      (else c))))

(define (tui-loop st)
  (let ((k (read-key)))
    (if (eq? k 'eof)
        #f
        (let ((action (handle-key! st k)))
          (if (eq? action 'quit)
              #f
              (begin
                (maybe-draw! st #t)
                (tui-loop st)))))))

(define (run-tui cfg)
  (let ((st (make-state cfg))
        (saved (enable-raw)))
    (dynamic-wind
      (lambda ()
        (display "\x1b[?1049h\x1b[?25l\x1b[2J\x1b[H")
        (force-output))
      (lambda ()
        (draw! st)
        (tui-loop st))
      (lambda ()
        (display "\x1b[?25h\x1b[?1049l")
        (force-output)
        (restore-stty saved)))))
